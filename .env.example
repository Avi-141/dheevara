# Copy to .env for local runs (gitignored), or set these in the cloud environment's settings.
# Never commit a value. Every value here stays empty.

# Sarvam: Bulbul TTS, speech-to-text, Vision OCR
SARVAM_API_KEY=
# Exa: reference corpus search and contents
EXA_API_KEY=
# fal: video, image and LoRA
FAL_KEY=
# Jev (typesafe.ai): decision and routing layer
JEV_API_KEY=
JEV_BASE_URL=
# Vāgdhenu chant service on a CUDA 12.1 box (services/vagdhenu/)
VAGDHENU_URL=
# Spend cap per run in US dollars (Avi set 15)
MAX_RUN_USD=
